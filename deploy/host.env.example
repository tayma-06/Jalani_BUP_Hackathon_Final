# Create /srv/jalani/.env on the target host; chmod 600. Replace ALL placeholders.
# DATABASE_URL must use the same DB credentials, URL-encoded if needed.
POSTGRES_USER=jalani
POSTGRES_DB=jalani
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
DATABASE_URL=postgresql+psycopg://jalani:REPLACE_WITH_RANDOM_PASSWORD@db:5432/jalani
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
VIEWER_USER=viewer
VIEWER_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
OPERATOR_USER=operator
OPERATOR_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
ADMIN_USER=admin
ADMIN_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
SIMULATOR_URL=http://simulator:8000
SIMULATION_SPEED=1
ML_SERVICE_URL=
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
