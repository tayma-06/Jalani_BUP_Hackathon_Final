# Local stack settings for docker-compose.yml. Copy to .env (never commit .env).
# Every value is optional: docker-compose.yml has a demo default for each one.
# Change ALL passwords and JWT_SECRET before exposing the app beyond your own machine.

APP_VERSION=local
GIT_SHA=dev

# Simulator speed: 1 = one sim day in ~96 s (demo), 8 = the simulator's default.
SIMULATION_SPEED=1
# Compose resolves services by name. Point this at a loopback port only when you
# run the backend directly on the host, outside compose.
SIMULATOR_URL=http://simulator:8000

POSTGRES_PASSWORD=jalani-local-password
JWT_SECRET=local-demo-secret-change-me-before-any-deploy
# DATABASE_URL is derived from POSTGRES_PASSWORD by docker-compose.yml and is not
# set here. A host deployment builds its own value; see deploy/host.env.example.

VIEWER_USER=viewer
VIEWER_PASSWORD=demo-viewer
OPERATOR_USER=operator
OPERATOR_PASSWORD=demo-operator
ADMIN_USER=admin
ADMIN_PASSWORD=demo-admin

GRAFANA_ADMIN_PASSWORD=demo-grafana

# Shared secret Alertmanager presents when it posts alerts to the backend. Change it on a host.
ALERT_WEBHOOK_TOKEN=demo-alert-webhook-token

# Demo-only failure injection buttons (crash, corrupt-next). Keep false outside rehearsals.
CHAOS_ENABLED=false

# Optional services. Empty = documented local fallbacks (statistical forecast, template explanations).
ML_SERVICE_URL=
# ML runs inside the backend; its active model is loaded from the database registry.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Seconds allowed for each AI call before the grounded fallback is used.
LLM_TIMEOUT_SECONDS=20
# Anthropic API key (console.anthropic.com). Set it and Claude writes the Overview briefing,
# with every number checked against the data; leave it empty for the grounded template.
LLM_API_KEY=
LLM_MODEL=claude-opus-5
# Override only for an AI gateway or proxy. Empty talks to the provider directly.
LLM_BASE_URL=

# Only if builds fail with "certificate verify failed" behind antivirus/proxy TLS scanning:
# path to a PEM bundle containing the normal public CAs plus the intercepting root CA.
# EXTRA_CA_FILE=./ca-bundle.pem
